# gate-exits
# PREPARED ONLY: requires approved reference freeze before Nata timing.
# 8 logical CPUs; 150 GB work disk; 6 VM-hour cap per CPU. No optimization variants.
profile python3 scripts/profile-precheck.py --out "$RESULTS/package0-profile"
freeze python3 -c 'import json; from pathlib import Path; f=json.loads(Path(".engine-perf-package0-freeze.json").read_text()); assert f["owner_accepted"] and f["policy"]=="0008-v1" and f["slice5_sha"]=="bb946ab"; assert f["manifest_sha256"] and f["fixture_hashes"] and f["package0_off_cost_rule"] and f["successor_fixture_hashes"]'
build CARGO_TARGET_DIR="$WORK/package0-target" CARGO_INCREMENTAL=0 cargo build --locked --release -j 4 -p nata -p nata-check && cp "$WORK/package0-target/release/nata" "$WORK/package0-nata" && chmod a-w "$WORK/package0-nata"
harness python3 scripts/bench-aggregate-closeout.py --self-test && python3 scripts/bench-aggregate-perf1-heavy.py self-test --work "$WORK/package0-self-test" && python3 -m unittest discover -s scripts -p test_bench_verdict.py
fixtures-ten mkdir -p "$WORK/package0-tmp" && TMPDIR="$WORK/package0-tmp" GEN_CHILDREN=10 scripts/gen-tpch.sh 10 "$WORK/package0-sf10"
sf-ten-unpinned package0_machine=$(uname -m) && case "$package0_machine" in x86_64) package0_machine=c3d-highcpu-8 ;; aarch64) package0_machine=n4a-highcpu-8 ;; *) exit 2 ;; esac && python3 scripts/bench-aggregate-closeout.py --policy 0008-v1 --early-sf10 --scale 10 --affinity unpinned --machine "$package0_machine" --binary "$WORK/package0-nata" --commit "$(cat .engine-perf-package0-commit)" --data "$WORK/package0-sf10" --out "$RESULTS/package0-sf10-unpinned"
sf-ten-pinned package0_machine=$(uname -m) && case "$package0_machine" in x86_64) package0_machine=c3d-highcpu-8 ;; aarch64) package0_machine=n4a-highcpu-8 ;; *) exit 2 ;; esac && python3 scripts/bench-aggregate-closeout.py --policy 0008-v1 --early-sf10 --scale 10 --affinity pinned --machine "$package0_machine" --binary "$WORK/package0-nata" --commit "$(cat .engine-perf-package0-commit)" --data "$WORK/package0-sf10" --out "$RESULTS/package0-sf10-pinned"
