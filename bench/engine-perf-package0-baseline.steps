# gate-exits
# PREPARED ONLY: requires approved reference freeze before Nata timing.
# 8 logical CPUs; 150 GB work disk; 6 VM-hour cap per CPU. No optimization variants.
tools sudo DEBIAN_FRONTEND=noninteractive apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq linux-perf time && sudo sysctl -w kernel.perf_event_paranoid=1 kernel.kptr_restrict=0
prepare mkdir -p "$WORK/package0/source" && cd "$SRC" && sha256sum -c .engine-perf-package0-source.sha256 && tar -xf .engine-perf-package0-source.tar -C "$WORK/package0/source"
profile cd "$WORK/package0/source" && python3 scripts/profile-precheck.py --all-events --out "$RESULTS/package0-profile"
freeze cd "$SRC" && python3 "$WORK/package0/source/scripts/check-engine-perf-freeze.py" .engine-perf-package0-freeze.json
build cd "$WORK/package0/source" && CARGO_TARGET_DIR="$WORK/package0-target" CARGO_INCREMENTAL=0 cargo build --locked --release -j 4 -p nata -p nata-check && cp "$WORK/package0-target/release/nata" "$WORK/package0-nata" && chmod a-w "$WORK/package0-nata"
harness cd "$WORK/package0/source" && python3 scripts/bench-aggregate-closeout.py --self-test && python3 scripts/bench-aggregate-perf1-heavy.py self-test --work "$WORK/package0-self-test" && python3 -m unittest discover -s scripts -p test_bench_verdict.py
fixtures-ten cd "$WORK/package0/source" && mkdir -p "$WORK/package0-tmp" && TMPDIR="$WORK/package0-tmp" GEN_CHILDREN=10 scripts/gen-tpch.sh 10 "$WORK/package0-sf10"
build-without cd "$WORK/package0/source" && RUSTFLAGS="--cfg nata_stats_disabled" CARGO_TARGET_DIR="$WORK/package0-without-target" CARGO_INCREMENTAL=0 cargo build --locked --release -j 4 -p nata && cp "$WORK/package0-without-target/release/nata" "$WORK/package0-without" && chmod a-w "$WORK/package0-without"
off-cost cd "$WORK/package0/source" && python3 scripts/bench-stats-off-cost.py --commit "$(cat "$SRC/.engine-perf-package0-commit")" --settled --without "$WORK/package0-without" --disabled "$WORK/package0-nata" --data "$WORK/package0-sf10" --queries q1 --budgets 4294967296 67108864 268435456 --out "$RESULTS/package0-off-cost"
sf-ten-unpinned cd "$WORK/package0/source" && package0_machine=$(uname -m) && case "$package0_machine" in x86_64) package0_machine=c3d-highcpu-8 ;; aarch64) package0_machine=n4a-highcpu-8 ;; *) exit 2 ;; esac && python3 scripts/bench-aggregate-closeout.py --policy 0008-v1 --early-sf10 --scale 10 --affinity unpinned --machine "$package0_machine" --binary "$WORK/package0-nata" --commit "$(cat "$SRC/.engine-perf-package0-commit")" --data "$WORK/package0-sf10" --out "$RESULTS/package0-sf10-unpinned"
sf-ten-pinned cd "$WORK/package0/source" && package0_machine=$(uname -m) && case "$package0_machine" in x86_64) package0_machine=c3d-highcpu-8 ;; aarch64) package0_machine=n4a-highcpu-8 ;; *) exit 2 ;; esac && python3 scripts/bench-aggregate-closeout.py --policy 0008-v1 --early-sf10 --scale 10 --affinity pinned --machine "$package0_machine" --binary "$WORK/package0-nata" --commit "$(cat "$SRC/.engine-perf-package0-commit")" --data "$WORK/package0-sf10" --out "$RESULTS/package0-sf10-pinned"
