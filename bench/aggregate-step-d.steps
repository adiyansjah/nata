# Copy this file verbatim to heavy.steps in the shipped checkout. Run the same
# job separately on n4a and c3d; parent supplies cloud approval and VM sizing.
# Each line is a resumable heavy job step. No timing target verdicts here.
prepare mkdir -p "$WORK/aggregate-tmp" && printf '%s\n' 'export TMPDIR="$WORK/aggregate-tmp" CARGO_BUILD_JOBS=2 CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0' 'unset AI_AGENT' 'set -o pipefail' > "$WORK/aggregate-env.sh" && aggregate_toolchain=$(python3 -c 'import tomllib; print(tomllib.load(open("rust-toolchain.toml", "rb"))["toolchain"]["channel"])') && printf 'export RUSTUP_TOOLCHAIN=%q\n' "$aggregate_toolchain" >> "$WORK/aggregate-env.sh"
build . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" CARGO_TARGET_DIR="$WORK/target-ws" cargo build --locked --release -p nata -p nata-check; }
fixtures . "$WORK/aggregate-env.sh" && { env -u AI_AGENT scripts/gen-tpch.sh 0.01 "$WORK/aggregate-data" && env -u AI_AGENT scripts/gen-tpch.sh 1 "$WORK/aggregate-sf1" && env -u AI_AGENT scripts/gen-sql-check-data.sh "$WORK/aggregate-data"; }
aggregate-gate . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" "$WORK/target-ws/release/nata-check" --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-data" --queries check/queries/aggregate; }
aggregate-spill-gate . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" "$WORK/target-ws/release/nata-check" --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-data" --queries check/queries/aggregate --force-aggregate-spill; }
sf1-spill-correctness . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" python3 scripts/check-aggregate-spill.py --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-sf1" --out "$RESULTS/aggregate-sf1" --rounds 0; }
memory-and-spill-loom . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" CARGO_TARGET_DIR="$WORK/loom-memory" LOOM_MAX_PREEMPTIONS=3 MEMORY_MODEL_TIMEOUT=3000 crates/nata-sched/run_memory_loom.sh; }
sql-fuzz-a . "$WORK/aggregate-env.sh" && { cd spikes/sqlfuzz && env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" NATA_TMP="$WORK/aggregate-tmp" NATA_BIN="$WORK/target-ws/release/nata" NATA_THREADS=1 python3 -I fuzz.py run-subset --seed 20261107 --cases 100000 --jobs 4 --target-cmd 'python3 -I adapters/nata_adapter.py' --out "$RESULTS/sql-fuzz-a"; }
sql-fuzz-b . "$WORK/aggregate-env.sh" && { cd spikes/sqlfuzz && env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" NATA_TMP="$WORK/aggregate-tmp" NATA_BIN="$WORK/target-ws/release/nata" NATA_THREADS=1 NATA_FORCE_AGGREGATE_SPILL=1 python3 -I fuzz.py run-subset --seed 22014202119 --cases 100000 --jobs 4 --target-cmd 'python3 -I adapters/nata_adapter.py' --out "$RESULTS/sql-fuzz-b"; }
spill-corruption-build . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" CARGO_TARGET_DIR="$WORK/target-ws" cargo test --locked -p nata-exec --test spill --no-run --message-format=json | python3 -c 'import json,sys; r=[json.loads(s) for s in sys.stdin]; print(next(x["executable"] for x in r if x.get("reason")=="compiler-artifact" and x.get("target",{}).get("name")=="spill" and x.get("executable")))' > "$RESULTS/spill-test-bin"; }
spill-corruption . "$WORK/aggregate-env.sh" && { TASK_SPILL_BINARY=$(cat "$RESULTS/spill-test-bin") && (ulimit -v 262144 && TMPDIR="$WORK/aggregate-tmp" NATA_SPILL_CASES=30000 NATA_SPILL_SEED=22014202119 "$TASK_SPILL_BINARY" seeded_corruption_rejected_before_arrow_allocation --exact --nocapture --test-threads=1); }
mutation-classifiers . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" python3 crates/nata-exec/test_mutate.py; }
exec-mutants . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" CARGO_BUILD_JOBS=2 python3 crates/nata-exec/mutate.py --work "$WORK/mut-exec" --out "$RESULTS/mut-exec.txt"; }
sql-mutants . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" CARGO_BUILD_JOBS=2 python3 crates/nata-sql/mutate.py --work "$WORK/mut-sql" --out "$RESULTS/mut-sql.txt"; }
wire-mutants . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" CARGO_BUILD_JOBS=2 python3 crates/nata-pgwire/mutate.py --work "$WORK/mut-wire"; }
memory-mutants . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" CARGO_BUILD_JOBS=2 LOOM_MAX_PREEMPTIONS=3 python3 crates/nata-sched/mutants/mutate.py --only '^memory-' --jobs 1 --out "$RESULTS/mut-memory.txt"; }
kernel-mutants . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" python3 crates/nata-kernels/mutate.py --jobs 1; }
parquet-nightly . "$WORK/aggregate-env.sh" && { CARGO_TARGET_DIR="$WORK/target-ws" NATA_FUZZ_CASES=30000 NATA_FUZZ_SEED=20261107 cargo test --release -p nata-parquet --features page-crc --test fuzz_files -- --nocapture; }
wire-codec-nightly . "$WORK/aggregate-env.sh" && { CARGO_TARGET_DIR="$WORK/target-ws" NATA_PGWIRE_SEED=322661912839 NATA_PGWIRE_CASES=1000000 cargo test -p nata-pgwire --test codec seeded_decoder_fuzz -- --nocapture; }
wire-reliability . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" CARGO_TARGET_DIR="$WORK/target-ws" NATA_PGWIRE_SEED=322661912839 NATA_PGWIRE_SCENARIOS=4000 NATA_PGWIRE_LIVE_CASES=20000 NATA_PGWIRE_CONTENTION=8 cargo test --release -p nata-pgwire --test reliability -- --nocapture --test-threads=1; }
aggregate-reliability . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" CARGO_TARGET_DIR="$WORK/target-ws" NATA_PGWIRE_AGGREGATE=1 NATA_PGWIRE_SEED=322661912839 NATA_PGWIRE_SCENARIOS=4000 NATA_PGWIRE_LIVE_CASES=20000 NATA_PGWIRE_CONTENTION=8 cargo test --release -p nata-pgwire --test reliability seeded_disconnect_cancel_kill_under_contention -- --nocapture --test-threads=1; }
restart-cleanup . "$WORK/aggregate-env.sh" && { TMPDIR="$WORK/aggregate-tmp" python3 scripts/check-aggregate-restart.py --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-sf1" --out "$RESULTS/aggregate-restart"; }
client-setup . "$WORK/aggregate-env.sh" && { bash scripts/aggregate-client-setup.sh; }
client-matrix . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" PGJDBC_JAR="$WORK/aggregate-pgjdbc.jar" "$WORK/aggregate-client/bin/python" scripts/check-aggregate-clients.py --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-data" --out "$RESULTS/aggregate-clients"; }
rss-one . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" python3 scripts/check-aggregate-rss.py --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-data" --sf1 "$WORK/aggregate-sf1" --threads 1 --rounds 3 --out "$RESULTS/aggregate-rss-1"; }
rss-eight . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" python3 scripts/check-aggregate-rss.py --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-data" --sf1 "$WORK/aggregate-sf1" --threads 8 --rounds 3 --out "$RESULTS/aggregate-rss-8"; }
server-rss . "$WORK/aggregate-env.sh" && { env -u AI_AGENT TMPDIR="$WORK/aggregate-tmp" python3 scripts/check-aggregate-rss.py --server --candidate "$WORK/target-ws/release/nata" --data "$WORK/aggregate-data" --sf1 "$WORK/aggregate-sf1" --threads 8 --rounds 3 --out "$RESULTS/aggregate-server-rss"; }
