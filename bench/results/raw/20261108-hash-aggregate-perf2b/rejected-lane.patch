--- /dev/null
+++ b/crates/nata-kernels/src/lane.rs
@@ -0,0 +1,78 @@
+//! Checked i64 accumulation with an exact i128 fallback. A machine overflow
+//! promotes storage; SQL precision is checked only at aggregate finalization.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Lane {
+    small: i64,
+    overflow: bool,
+    exact: i128,
+}
+impl PartialEq for Lane {
+    fn eq(&self, other: &Self) -> bool {
+        self.value() == other.value()
+    }
+}
+impl Eq for Lane {}
+impl Lane {
+    pub fn value(self) -> i128 {
+        if self.overflow {
+            self.exact
+        } else {
+            i128::from(self.small)
+        }
+    }
+    pub fn from_exact(value: i128) -> Self {
+        match i64::try_from(value) {
+            Ok(small) => Self {
+                small,
+                overflow: false,
+                exact: 0,
+            },
+            Err(_) => Self {
+                small: 0,
+                overflow: true,
+                exact: value,
+            },
+        }
+    }
+    /// On i128 overflow leave the lane untouched so the caller can promote to
+    /// its checked i256 state. Never reuse the wrapped i64 result on fallback.
+    pub fn add(&mut self, value: i128) -> Option<()> {
+        if !self.overflow
+            && let Ok(value) = i64::try_from(value)
+        {
+            let (next, overflow) = self.small.overflowing_add(value);
+            if !overflow {
+                self.small = next;
+                return Some(());
+            }
+        }
+        let next = self.value().checked_add(value)?;
+        self.exact = next;
+        self.overflow = true;
+        Some(())
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn fallback_is_exact_and_keeps_state_on_i128_overflow() {
+        for (a, b) in [
+            (i128::from(i64::MAX), 1),
+            (i128::from(i64::MIN), -1),
+            (i128::MAX, 1),
+            (i128::MIN, -1),
+            (0, i128::MAX),
+            (0, i128::MIN),
+        ] {
+            let mut lane = Lane::from_exact(a);
+            assert_eq!(lane.add(b).is_some(), a.checked_add(b).is_some());
+            assert_eq!(lane.value(), a.checked_add(b).unwrap_or(a));
+        }
+        let mut lane = Lane::from_exact(i128::from(i64::MAX));
+        lane.add(1).unwrap();
+        lane.add(-1).unwrap();
+        assert_eq!(lane.value(), i128::from(i64::MAX));
+        assert!(lane.overflow);
+    }
+}
