+mod lane_proofs {
+    use super::lane::Lane;
+    #[kani::proof]
+    fn i64_lane_fallback_exact() {
+        let a: i64 = kani::any();
+        let b: i64 = kani::any();
+        let mut lane = Lane::from_exact(i128::from(a));
+        assert_eq!(lane.add(i128::from(b)), Some(()));
+        assert_eq!(lane.value(), i128::from(a) + i128::from(b));
+        kani::cover!(a.checked_add(b).is_none());
+        kani::cover!(a.checked_add(b).is_some());
+    }
+    #[kani::proof]
+    fn i128_lane_fallback_preserves_overflow() {
+        let a: i128 = kani::any();
+        let b: i128 = kani::any();
+        let mut lane = Lane::from_exact(a);
+        let expected = a.checked_add(b);
+        assert_eq!(lane.add(b).is_some(), expected.is_some());
+        assert_eq!(lane.value(), expected.unwrap_or(a));
+        kani::cover!(expected.is_none());
+        kani::cover!(expected.is_some());
+    }
+}
diff --git a/crates/nata-kernels/src/lane.rs b/crates/nata-kernels/src/lane.rs
