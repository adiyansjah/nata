diff --git a/crates/nata-exec/tests/aggregate_spill.rs b/crates/nata-exec/tests/aggregate_spill.rs
index 4bfc074..9d4b387 100644
--- a/crates/nata-exec/tests/aggregate_spill.rs
+++ b/crates/nata-exec/tests/aggregate_spill.rs
@@ -441,3 +441,49 @@ fn forced_spill_flushes_each_decoded_batch_inside_a_morsel() {
     empty(&base);
     std::fs::remove_dir_all(d).expect("cleanup");
 }
+
+#[test]
+fn decode_batch_growth_preserves_argument_error_positions_before_having() {
+    let d = dir("spill-decode-error-phase");
+    let p = d.join("t.parquet");
+    let values: ArrayRef = Arc::new(Int32Array::from_iter_values(0..1025));
+    write_batch(
+        &p,
+        &RecordBatch::try_from_iter([("id", values)]).expect("batch"),
+        1025,
+    );
+    // The first argument fails in a later original 256-row span. The second
+    // fails in the first span, even though the larger decode reads both at once.
+    // A pushed predicate compacts each span; chunking after it would be wrong.
+    let sql = format!(
+        "SELECT sum(1 // (256-id)), sum(1 // id) FROM '{}' WHERE id <> 1 HAVING false LIMIT 0",
+        p.display()
+    );
+    let planned = plan_sql(&sql, &FsSource).expect("plan");
+    let expected = planned
+        .plan
+        .aggregate
+        .as_ref()
+        .expect("aggregate")
+        .aggregates[1]
+        .arg
+        .as_ref()
+        .expect("arg")
+        .pos;
+    let mut cfg = ExecConfig::new(1);
+    cfg.aggregate_memory_bytes = Some(8 << 30);
+    let mut observed = Observed::default();
+    let error = execute_observed(
+        Arc::new(planned.plan),
+        &cfg,
+        None,
+        &mut observed,
+        |_| Ok(()),
+    )
+    .expect_err("division");
+    let nata_parquet::ErrorKind::Eval { line, column, .. } = error.kind else {
+        panic!("{error:?}")
+    };
+    assert_eq!((line, column), (expected.line, expected.col));
+    std::fs::remove_dir_all(d).expect("cleanup");
+}
