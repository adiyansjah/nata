+#[cfg(test)]
+#[allow(
+    clippy::arithmetic_side_effects,
+    reason = "independent boundary-test arithmetic"
+)]
+mod perf2c_tests {
+    use super::*;
+    #[test]
+    fn batch_prefix_promotion_cancellation_and_invalid_input() {
+        for p in 1..=38 {
+            let m = decimal_limit(p).expect("test boundary") - 1;
+            let values = [m, m, -m, -m, 1];
+            let mut expected = ExactSum::default();
+            let mut got = expected;
+            for v in values {
+                expected.add(v).expect("test boundary");
+            }
+            got.add_batch(values.into_iter(), p).expect("test boundary");
+            assert_eq!(got, expected);
+        }
+        let values = [1, 2, i128::MIN, 3];
+        let mut got = ExactSum::default();
+        assert_eq!(
+            got.add_batch(values.into_iter(), 1),
+            Err(AggregateError::InvalidState)
+        );
+        assert_eq!(got.count(), 2);
+        assert_eq!(got.decimal_sum(38), Ok(Some(3)));
+        let mut got = ExactSum::default();
+        got.add(99_999_999_999_999_999_999_999_999_999_999_999_999)
+            .expect("test boundary");
+        got.add(i128::MAX - 99_999_999_999_999_999_999_999_999_999_999_999_999)
+            .expect("test boundary");
+        got.add_batch([1, -1].into_iter(), 1)
+            .expect("test boundary"); // must promote, never wrap
+        assert_eq!(got.sum, Sum::Narrow(i128::MAX));
+        assert!(!crate::sum_admission::batch_envelope(
+            i128::MAX.unsigned_abs(),
+            1,
+            1
+        ));
+        let mut got = ExactSum {
+            sum: Sum::Narrow(0),
+            count: u64::MAX - 2,
+        };
+        assert_eq!(
+            got.add_batch([1, 1].into_iter(), 1),
+            Err(AggregateError::Overflow)
+        );
+        assert_eq!(got.count, u64::MAX - 1);
+        assert_eq!(got.sum, Sum::Narrow(1));
+    }
+}
