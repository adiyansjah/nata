+    /// Sufficient narrow-state admission, with an upper bound on batch rows.
+    pub fn can_add_batch(&self, n: u64, precision: u8) -> bool {
+        let (Ok(limit), Sum::Narrow(current)) = (decimal_limit(precision), self.sum) else {
+            return false;
+        };
+        (1..=38).contains(&precision)
+            && crate::sum_admission::batch_envelope(
+                current.unsigned_abs(),
+                n,
+                limit.unsigned_abs().saturating_sub(1),
+            )
+            && checked_count(self.count, n).is_ok()
+    }
+
+    /// A selected valid batch for one group. Validate once, then either use
+    /// a narrow envelope or replay the unchanged checked/promoting updates.
+    #[allow(
+        clippy::disallowed_methods,
+        reason = "R26: admitted batch bounds every prefix"
+    )]
+    pub fn add_batch<I>(&mut self, values: I, precision: u8) -> Result<(), AggregateError>
+    where
+        I: Iterator<Item = i128> + Clone,
+    {
+        let mut n = 0u64;
+        let mut magnitude = 0;
+        for v in values.clone() {
+            n = n.checked_add(1).ok_or(AggregateError::Overflow)?;
+            magnitude = magnitude.max(v.unsigned_abs());
+        }
+        if (1..=38).contains(&precision)
+            && let Ok(limit) = decimal_limit(precision)
+            && magnitude < limit.unsigned_abs()
+            && let Sum::Narrow(current) = self.sum
+            && crate::sum_admission::batch_envelope(
+                current.unsigned_abs(),
+                n,
+                limit.unsigned_abs().saturating_sub(1),
+            )
+            && let Ok(count) = checked_count(self.count, n)
+        {
+            let mut sum = current;
+            for v in values {
+                sum = sum.wrapping_add(v);
+            }
+            self.sum = Sum::Narrow(sum);
+            self.count = count;
+            return Ok(());
+        }
+        for v in values {
+            self.add(v)?;
+        }
+        Ok(())
+    }
