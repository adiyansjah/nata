+/// Conservative product envelope. |x| < 2^bits(a), |y| < 2^bits(b),
+/// so |xy| < 2^(bits(a)+bits(b)) <= limit <= 10^38 < i128::MAX.
+/// Zero gets the same conservative envelope as other inputs; no special case
+/// can admit an out-of-domain operand. Called once per selected batch.
+#[allow(
+    clippy::arithmetic_side_effects,
+    reason = "bit lengths are at most 128; positive limit has at most 127 leading zeros"
+)]
+pub fn product_fits(a: u128, b: u128, limit: u128) -> bool {
+    let bits = (128 - a.leading_zeros()) + (128 - b.leading_zeros());
+    limit > 0
+        && limit <= 100_000_000_000_000_000_000_000_000_000_000_000_000
+        && bits <= 127 - limit.leading_zeros()
+}
