+++ b/spikes/kani-nata-kernels/src/lib.rs
@@ -1457,3 +1457,49 @@ mod decimal_proofs {
         kani::cover!(ok); kani::cover!(!ok);
     }
 }
+
+#[cfg(kani)]
+mod perf2c_proofs {
+    use super::decimal::product_fits;
+    #[kani::proof]
+    fn perf2c_product_envelope() {
+        let x: i128 = kani::any();
+        let y: i128 = kani::any();
+        let a: u128 = kani::any();
+        let b: u128 = kani::any();
+        let limit: u128 = kani::any();
+        kani::assume(x.unsigned_abs() <= a && y.unsigned_abs() <= b);
+        kani::assume(product_fits(a, b, limit));
+        let (value, overflow) = x.overflowing_mul(y);
+        assert!(!overflow);
+        assert!(value.unsigned_abs() < limit);
+        assert_eq!(Some(value), x.checked_mul(y));
+        kani::cover!(x < 0 && y > 0);
+        kani::cover!(x > 1_000_000_000 && y < -100);
+    }
+}
+
+// No accumulator check is elided by these induction lemmas. They establish
+// the n/p budget, not correctness of Arrow's i256 implementation.
+#[cfg(kani)]
+mod perf2c_accumulation_bounds {
+    #[kani::proof]
+    fn perf2c_decimal18_accumulation_induction() {
+        const M: i128 = 999_999_999_999_999_999;
+        let n: u64 = kani::any();
+        let sum: i128 = kani::any();
+        let value: i128 = kani::any();
+        kani::assume(n < u64::MAX - 1);
+        // 10^18-1 < 2^60. This conservative envelope avoids assuming
+        // anything about the sign or cancellation history of the sum.
+        let bound = i128::from(n) << 60;
+        kani::assume(sum >= -bound && sum <= bound);
+        kani::assume(value >= -M && value <= M);
+        let next_bound = i128::from(n + 1) << 60;
+        let next = sum.checked_add(value).unwrap();
+        assert!(next >= -next_bound && next <= next_bound);
+        assert!(next.unsigned_abs() < 100_000_000_000_000_000_000_000_000_000_000_000_000);
+        kani::cover!(n > (1u64 << 63) && sum < 0 && value < 0);
+        kani::cover!(n == 0 && sum == 0);
+    }
+}
