diff --git a/crates/nata-kernels/tests/decimal_batch_bounds.rs b/crates/nata-kernels/tests/decimal_batch_bounds.rs
new file mode 100644
index 0000000..2785f1e
--- /dev/null
+++ b/crates/nata-kernels/tests/decimal_batch_bounds.rs
@@ -0,0 +1,85 @@
+use nata_kernels::decimal::{Decimal, Fail, Op, product_fits};
+
+#[test]
+fn product_envelope_boundaries() {
+    assert!(product_fits(100_000_000, 100, 10u128.pow(18)));
+    assert!(product_fits(100_000_000_000, 110, 10u128.pow(18)));
+    assert!(!product_fits(1_000_000_000, 1_000_000_000, 10u128.pow(18)));
+    assert!(!product_fits(1u128 << 126, 4, 10u128.pow(38)));
+    assert!(!product_fits(u128::MAX, u128::MAX, 10u128.pow(38)));
+    assert!(!product_fits(0, 0, 0));
+    assert!(!product_fits(0, 0, u128::MAX));
+}
+
+#[test]
+fn batch_product_keeps_overflow_and_its_row() {
+    for (p, x, y) in [
+        (18, 1_000_000_000, 1_000_000_000),
+        (38, 10i128.pow(38) - 1, 2),
+        (38, i128::MIN, -1),
+        (38, i128::MAX, 2),
+    ] {
+        for sign in [-1i128, 1] {
+            let x = if x == i128::MIN { x } else { x * sign };
+            let k = Decimal::new(Op::Mul, 0, 0, p, 0).expect("type");
+            let (a, b) = ([7, x, 9], [3, y, 2]);
+            let (mut out, mut valid) = ([0; 3], [false; 3]);
+            assert_eq!(
+                k.column(
+                    &a,
+                    &[true; 3],
+                    &b,
+                    &[true; 3],
+                    &[0, 1, 2],
+                    &mut out,
+                    &mut valid
+                ),
+                Err(Fail::Overflow)
+            );
+            assert_eq!(out[0], 21);
+            assert_eq!(valid, [true, false, false]);
+            // Invalid and unselected extremes must not become errors.
+            k.column(
+                &a,
+                &[true, false, true],
+                &b,
+                &[true; 3],
+                &[0, 1, 2],
+                &mut out,
+                &mut valid,
+            )
+            .expect("NULL masked");
+            k.column(
+                &a,
+                &[true; 3],
+                &b,
+                &[true; 3],
+                &[0, 2],
+                &mut out,
+                &mut valid,
+            )
+            .expect("selection masked");
+        }
+    }
+}
+
+#[test]
+fn batch_product_matches_generic_for_signs_masks_and_wide_zero() {
+    let k = Decimal::new(Op::Mul, 0, 0, 18, 0).expect("type");
+    for x in [-100_000_000i128, -1, 0, 1, 100_000_000, i128::MAX] {
+        for y in [-110i128, -1, 0, 1, 110] {
+            for mask in 0..16u8 {
+                let (a, b) = ([x, y], [y, x]);
+                let av = [mask & 1 != 0, mask & 2 != 0];
+                let bv = [mask & 4 != 0, mask & 8 != 0];
+                let (mut fast, mut fv, mut generic, mut gv) =
+                    ([0; 2], [false; 2], [0; 2], [false; 2]);
+                assert_eq!(
+                    k.column(&a, &av, &b, &bv, &[0, 1], &mut fast, &mut fv),
+                    k.column_checked(&a, &av, &b, &bv, &[0, 1], &mut generic, &mut gv)
+                );
+                assert_eq!((fast, fv), (generic, gv));
+            }
+        }
+    }
+}
