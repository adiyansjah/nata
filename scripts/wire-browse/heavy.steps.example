# Copy to heavy.steps before packaging. Run each step serially; retain all exits.
machine-type bash -o pipefail -c 'curl -fsS -H "Metadata-Flavor: Google" http://metadata.google.internal/computeMetadata/v1/instance/machine-type | sed "s,.*/,,"'
matrix CARGO_BUILD_JOBS=4 bash scripts/wire-skeleton/run.sh
browse-oracle bash scripts/wire-browse/run-oracle.sh
protocol CARGO_BUILD_JOBS=4 cargo test -p nata-pgwire --test protocol -- --nocapture
metadata-fuzz CARGO_BUILD_JOBS=4 NATA_METADATA_CASES=1000000 cargo test -p nata-pgwire --lib seeded_metadata_fuzz -- --nocapture
wire-mutants CARGO_BUILD_JOBS=4 python3 crates/nata-pgwire/mutate.py --work "$WORK/wire-browse-mutants"
