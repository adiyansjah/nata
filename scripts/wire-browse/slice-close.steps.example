# Prepared gate commands; resource fairness currently FAILS (see results record).
# Do not treat this as a passing closeout plan. Copy via package-close.sh.
# Serial steps; every exit is a gate.
# Matrix exit 1 is retained separately and accepted ONLY by exact deviations.
# DBeaver failures, P16 misses/noise and resource excess remain failing gates.
machine-type bash -o pipefail -c 'curl -fsS -H "Metadata-Flavor: Google" http://metadata.google.internal/computeMetadata/v1/instance/machine-type | sed "s,.*/,,"'
machine-context bash -c 'uname -m; lscpu; rustc --version; cargo --version; ulimit -a'
apt-index sudo apt-get update -qq
timing-tools sudo apt-get install -y time linux-perf
matrix-deps sudo apt-get install -y default-jdk-headless postgresql-15 postgresql-client-15 libpq-dev python3-venv
pg16-install bash scripts/wire-browse/install-pg16.sh
matrix-psql-version bash scripts/wire-browse/install-matrix-client.sh
matrix-and-deviations bash scripts/wire-browse/matrix-verdict.sh
browse-pg15 PG_MAJOR=15 bash scripts/wire-browse/run-oracle.sh
protocol cargo test --locked -j 4 -p nata-pgwire --test protocol -- --nocapture
metadata-scratch cargo test --locked -j 4 -p nata-pgwire --lib metadata_scratch_cap -- --nocapture
loaded-native NATA_PGWIRE_CONTENTION=8 cargo test --locked -j 4 -p nata-pgwire --test reliability -- --nocapture
metadata-fuzz NATA_METADATA_CASES=1000000 cargo test --locked -j 4 -p nata-pgwire --lib seeded_metadata_fuzz -- --nocapture
wire-mutants LOOM_MAX_PREEMPTIONS=3 CARGO_BUILD_JOBS=4 python3 crates/nata-pgwire/mutate.py --work "$WORK/wire-browse-mutants"
portal-loom-bound-3 LOOM_MAX_PREEMPTIONS=3 bash crates/nata-pgwire/run_portal_loom.sh
scheduler-loom-bound-3 LOOM_MAX_PREEMPTIONS=3 CARGO_BUILD_JOBS=4 bash crates/nata-sched/run_loom.sh
memory-loom-bound-3 LOOM_MAX_PREEMPTIONS=3 CARGO_BUILD_JOBS=4 bash crates/nata-sched/run_memory_loom.sh
bridge-loom-bound-3 LOOM_MAX_PREEMPTIONS=3 CARGO_BUILD_JOBS=4 BRIDGE_COMBINED_IO=1 bash crates/nata-sched/run_bridge_loom.sh
resource-gate-mutants "$WORK/wire-skeleton-venv/bin/python" scripts/wire-browse/check-gate-mutants.py
p16-gate-controls "$WORK/wire-skeleton-venv/bin/python" scripts/wire-browse/test_p16.py
resource-gates ORACLE_EXTRA=resources PG_MAJOR=15 bash scripts/wire-browse/run-oracle.sh
snapshot-cap-mutant "$WORK/wire-skeleton-venv/bin/python" scripts/wire-browse/snapshot-mutant.py --nata "${CARGO_TARGET_DIR:-target}/debug/nata" --work "$WORK/snapshot-cap-mutant"
pg16-parity PG_MAJOR=16 bash scripts/wire-browse/run-oracle.sh
dbeaver-r24 bash scripts/wire-browse/dbeaver-gate.sh
p16-builds bash scripts/wire-browse/prepare-p16.sh
p16-streaming-and-regression ORACLE_EXTRA=p16 PG_MAJOR=16 bash scripts/wire-browse/run-oracle.sh
