# Resource gate only; setup is not a new matrix verdict.
rerun-prerequisites bash -euc 'sudo DEBIAN_FRONTEND=noninteractive apt-get update -qq; sudo DEBIAN_FRONTEND=noninteractive apt-get install -y time default-jdk-headless postgresql-15 postgresql-client-15 libpq-dev python3-venv; bash scripts/wire-skeleton/run.sh --prepare-only; cargo build --locked --release -p nata -j 4'
resource-gates NATA_BROWSE_BIN="${CARGO_TARGET_DIR:-target}/release/nata" ORACLE_EXTRA=resources PG_MAJOR=15 bash scripts/wire-browse/run-oracle.sh
