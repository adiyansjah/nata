# Spot prices for the machines the orchestrator may use: USD per hour for the whole machine, us-central1.
# Source: Cloud Billing Catalog API (Compute Engine), fetched 2026-11-03 21:28 UTC; see
# bench/results/20261104-gcp-prices-and-quota.md. Prices change: recompute them before every run.
RATE_n4a_highcpu_8=0.0984
RATE_n4a_standard_8=0.1166
RATE_c4a_highcpu_8=0.1572
RATE_c4a_standard_8=0.1864
# DERIVED, not fetched: high-memory shapes have 8 GiB per vCPU, so n4a-highmem-8 = 8 x 0.01002 + 64 x 0.00114 and
# c4a-highmem-8 = 8 x 0.01601 + 64 x 0.00182 (core and RAM Spot prices from the same fetch). The same formula
# reproduces the fetched n4a-highcpu-8 price (8 x 0.01002 + 16 x 0.00114 = 0.0984). Recompute before the run.
RATE_n4a_highmem_8=0.1531
RATE_c4a_highmem_8=0.2446
# Also DERIVED (32 x 0.01002 + 64 x 0.00114); n4a-highcpu-32 has 32 vCPU and 64 GiB.
RATE_n4a_highcpu_32=0.3936
# Also DERIVED from the same core and RAM prices (cores x 0.01002 + GiB x 0.00114): small and memory-heavy shapes.
RATE_n4a_highcpu_4=0.0492
RATE_n4a_highcpu_16=0.1968
RATE_n4a_highmem_16=0.3062
# x86-64 Spot rates, us-central1, USD per hour for the whole machine. FETCHED 2026-11-04 from the Cloud Billing Catalog API
# (Compute Engine 6F81-5844-456A; 'Spot Preemptible ... Instance Core/Ram running in Americas'); machine totals = cores x core
# price + GiB x RAM price. Core / RAM per hour: C3D AMD Genoa 0.00677 / 0.00091; C3 Intel Sapphire Rapids 0.01296 / 0.00147;
# N4 Intel 0.01753 / 0.00199; C4 Intel 0.02074 / 0.00236. highcpu = 2 GiB per vCPU.
RATE_c3d_highcpu_8=0.0687
RATE_c3d_highcpu_16=0.1374
RATE_c3d_highcpu_32=0.2749
RATE_c3_highcpu_8=0.1272
RATE_n4_highcpu_8=0.1721
RATE_c4_highcpu_8=0.2037
RATE_t2a_standard_8=0.1579
RATE_t2a_standard_16=0.3161
# External IPv4 on a Spot VM, USD per hour.
IP_USD_PER_HOUR=0.0025
# Disk capacity, USD per GiB-month. The newer ARM families (C4A, N4A) accept only Hyperdisk; T2A only persistent disks.
DISK_USD_PER_GIB_MONTH_hyperdisk=0.08
DISK_USD_PER_GIB_MONTH_pd=0.10
# Hyperdisk charges IOPS and throughput above a free baseline. The default provisioning was not verified,
# so the cost bound for a Hyperdisk run adds this allowance.
HYPERDISK_EXTRA_ALLOWANCE_USD=0.03
