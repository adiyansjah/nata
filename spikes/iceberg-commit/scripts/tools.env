# Apache Iceberg 1.12.0 source release (sha512 from dist.apache.org). The REST catalog under test is built from it:
#   ./gradlew :iceberg-open-api:shadowJar   (the task the project's own docker/iceberg-rest-fixture README names)
ICEBERG_VERSION=1.12.0
ICEBERG_SRC_URLS='https://downloads.apache.org/iceberg/apache-iceberg-1.12.0/apache-iceberg-1.12.0.tar.gz https://archive.apache.org/dist/iceberg/apache-iceberg-1.12.0/apache-iceberg-1.12.0.tar.gz'
ICEBERG_SRC_SHA512=505b4d92baf9a2b55c3893bfa1b50289a0bf0051109d81f0a92825f406c28be9096be31d5c22ed68a2d7abd39fcfb0888729bb1917216b06ac200ac0fbf11a28

# Independent reader of the Avro we write (optional step; pip pins the version, not the file hashes).
PYICEBERG_VERSION=0.12.0

# Apache Polaris 1.8.0 (a PRODUCT catalog; used by IC_MODE=polaris). Binary distribution, a JVM server that needs Java 21 or newer.
# The sha512 is the one published at downloads.apache.org (checked against the downloaded file on 2026-11-05); the PGP signature (.asc) was NOT
# verified: gpg was not available. The sha256 is the one this spike computed on 2026-11-04 and again on 2026-11-05.
POLARIS_VERSION=1.8.0
POLARIS_URL=https://downloads.apache.org/polaris/1.8.0/polaris-bin-1.8.0.tgz
POLARIS_SHA512=52b79320f0ccd0fddc8e77b9ebd36b74710e6f5bab36f07a1f01175206923e0e146136c0f377f6bf183baf19bbf8481a2a380f53d660edcd039518361fdf0ca2
POLARIS_SHA256=2d295cafdae1c41a76739899988c61d6a6234dd92a96d89cf538d80166aa76d0

