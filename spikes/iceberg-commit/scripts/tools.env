# Pinned tools of the iceberg-commit spike. Every download is verified against the checksum here before it is used.
# The checksums were computed (or, where the publisher states one, copied) on 2026-11-04; sources are in
# bench/results/20261104-iceberg-commit.md. TLA+ v1.7.4 publishes no checksum: the value below is the sha256 of the file
# downloaded on that date (trust on first use; the file is the release asset of github.com/tlaplus/tlaplus).

# TLA+ tools (TLC model checker, SANY parser). 1.7.4 is the latest release that is not marked pre-release.
TLA_VERSION=v1.7.4
TLA_URL=https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
TLA_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88

# Eclipse Temurin JDK 17 (checksums from the Adoptium API). Used for TLC and to build the Iceberg REST fixture.
